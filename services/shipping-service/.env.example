# Shipping Service Config
PROJECT_NAME=Shipping Service
API_V1_STR=/api/v1
PORT=8007

# Database
DATABASE_URL=postgresql+asyncpg://shipping_user:shipping_dev_pass@localhost:5432/shipping_db
ENABLE_SQLITE_FALLBACK=true
DATABASE_SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./shipping_service.db
ALEMBIC_CHECK_ON_STARTUP=true

# Security toggles
REQUIRE_INBOUND_HMAC=false
REQUIRE_NONCE_GUARD=false
TIMESTAMP_TOLERANCE_SECONDS=300
INTERNAL_API_TOKEN=shipping_internal_dev_token

# Vault Integration
VAULT_ENABLED=false
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
VAULT_FLE_KEY=shipping-fle-key
VAULT_SIGN_KEY=shipping-sign-key
VAULT_HMAC_KEY=order-hmac-key
VAULT_AUDIT_KEY=shipping-audit-key

# Redis
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/7
REDIS_NONCE_TTL_SECONDS=600

# Kafka
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_SHIPPING=shipping.events
KAFKA_TOPIC_ORDER_CONFIRMED=order.confirmed
KAFKA_TOPIC_AUDIT=audit-logs
KAFKA_CONSUMER_GROUP=shipping-service

# Carrier
CARRIER_FORCE_MOCK=true
CARRIER_PROVIDER=mock
GHN_API_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_API_KEY=
GHN_WEBHOOK_SECRET=dev-ghn-webhook-secret

# Local dev crypto fallback
LOCAL_CRYPTO_SECRET=local-dev-shipping-crypto-key-32!
