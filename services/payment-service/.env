# Payment Service Config
PROJECT_NAME=Payment Service
API_V1_STR=/api/v1
PORT=8004

# Database
DATABASE_URL=postgresql+asyncpg://uitstore:uitstore_dev@localhost:5432/payment_db
ENABLE_SQLITE_FALLBACK=true
DATABASE_SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./payment_service.db
ALEMBIC_CHECK_ON_STARTUP=false

# Security toggles
REQUIRE_INBOUND_HMAC=false
REQUIRE_NONCE_GUARD=false
TIMESTAMP_TOLERANCE_SECONDS=300
INTERNAL_API_TOKEN=payment_internal_dev_token

# Vault Integration
VAULT_ENABLED=false
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
VAULT_FLE_KEY=payment-fle-key
VAULT_SIGN_KEY=payment-sign-key
VAULT_HMAC_KEY=order-hmac-key
VAULT_AUDIT_KEY=payment-audit-key

# Redis (Idempotency and Nonce store)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/1
REDIS_NONCE_TTL_SECONDS=600

# Kafka
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PAYMENTS=payment.events
KAFKA_TOPIC_AUDIT=audit-logs

# Stripe sandbox configs (Used if Vault is disabled; in prod these are loaded from Vault KV)
STRIPE_API_KEY=sk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_mock
STRIPE_PUBLISHABLE_KEY=pk_test_mock

# Bank payout gateway settings
BANK_PAYOUT_STUB=true

# Local dev crypto fallback (when Vault disabled/unavailable)
LOCAL_CRYPTO_SECRET=local-dev-payment-crypto-key-32b!
