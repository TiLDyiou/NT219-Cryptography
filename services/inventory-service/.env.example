# Inventory Service Config
PROJECT_NAME=Inventory Service
API_V1_STR=/api/v1
PORT=8005

# Database
DATABASE_URL=postgresql+asyncpg://inventory_user:inventory_dev_pass@localhost:5432/inventory_db
ENABLE_SQLITE_FALLBACK=true
DATABASE_SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./inventory_service.db
ALEMBIC_CHECK_ON_STARTUP=true

# Security toggles
REQUIRE_INBOUND_HMAC=false
REQUIRE_NONCE_GUARD=false
TIMESTAMP_TOLERANCE_SECONDS=300
INTERNAL_API_TOKEN=inventory_internal_dev_token

# Reservation TTL (minutes)
RESERVATION_TTL_MINUTES=15

# Vault Integration
VAULT_ENABLED=false
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
VAULT_FLE_KEY=inventory-fle-key
VAULT_SIGN_KEY=inventory-sign-key
VAULT_HMAC_KEY=order-hmac-key
VAULT_AUDIT_KEY=inventory-audit-key

# Redis (Idempotency and Nonce store)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/2
REDIS_NONCE_TTL_SECONDS=600

# Kafka
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_INVENTORY=inventory.events
KAFKA_TOPIC_AUDIT=audit-logs

# Local dev crypto fallback
LOCAL_CRYPTO_SECRET=local-dev-inventory-crypto-key-32!
