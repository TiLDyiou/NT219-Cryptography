# Order Service
PROJECT_NAME=Order Service
API_V1_STR=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://order_user:order_dev_pass@localhost:5432/enmerce_order
ENABLE_SQLITE_FALLBACK=true
DATABASE_SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./order_service.db

# Security toggles (enable in production / inter-service routes)
REQUIRE_INBOUND_HMAC=false
REQUIRE_NONCE_GUARD=false
TIMESTAMP_TOLERANCE_SECONDS=300
INTERNAL_API_TOKEN=order_internal_dev_token

# Vault
VAULT_ENABLED=false
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
VAULT_FLE_KEY=order-fle-key
VAULT_SIGN_KEY=order-sign-key
VAULT_HMAC_KEY=order-hmac-key

# Redis (anti-replay nonce store)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_NONCE_TTL_SECONDS=600

# Kafka
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC_CHECKOUT=order.checkout
KAFKA_TOPIC_AUDIT=audit-logs

# Payment service (sync HTTPS + HMAC)
PAYMENT_SERVICE_URL=http://localhost:8004
PAYMENT_MTLS_ENABLED=false
PAYMENT_DEV_STUB_ON_FAILURE=true
# PAYMENT_CLIENT_CERT=/path/to/client.crt
# PAYMENT_CLIENT_KEY=/path/to/client.key
# PAYMENT_CA_CERT=/path/to/ca.crt

# Local dev crypto fallback (when Vault disabled/unavailable)
LOCAL_CRYPTO_SECRET=local-dev-order-crypto-key-32b!
