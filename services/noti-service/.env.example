DATABASE_URL=postgresql+asyncpg://notification_user:notification_dev_pass@localhost:5432/notification_db
DATABASE_SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./noti_service.db
ENABLE_SQLITE_FALLBACK=false

VAULT_ENABLED=false
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_FLE_KEY=notification-fle-key
VAULT_SIGN_KEY=notification-sign-key
VAULT_HMAC_KEY=notification-hmac-key
VAULT_AUDIT_KEY=notification-audit-key
VAULT_SMTP_SECRET_PATH=secret/data/notification/smtp

REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/8
REDIS_NONCE_TTL_SECONDS=600
REDIS_IDEMPOTENCY_TTL_SECONDS=86400
RATE_LIMIT_TOKENS=10
RATE_LIMIT_WINDOW_SECONDS=60

KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_ORDER_CHECKOUT=order.checkout
KAFKA_TOPIC_PAYMENT_EVENTS=payment.events
KAFKA_TOPIC_SHIPPING_EVENTS=shipping.events
KAFKA_TOPIC_NOTIFICATION_EVENTS=notification.events
KAFKA_TOPIC_AUDIT=audit-logs
KAFKA_TOPIC_DLQ=notification.dlq
KAFKA_CONSUMER_GROUP=noti-service

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME=Enmerce
SMTP_STARTTLS_REQUIRED=true

REQUIRE_INBOUND_HMAC=true
REQUIRE_NONCE_GUARD=true
LOCAL_CRYPTO_SECRET=local-dev-notification-crypto-key-32!
