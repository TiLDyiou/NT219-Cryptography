# Copy file này thành .env và điền IP Tailscale thực tế
# Lấy IP: tailscale ip -4  (chạy trên từng máy)

# IP Tailscale của máy Mac này (NODE-4)
NODE4_IP=

# IP Tailscale của NODE-1 (Ingress - máy chạy Keycloak, Nginx, Envoy)
VM1_IP=

# IP Tailscale của NODE-2 (Service Mesh - máy chạy catalog, order, cart...)
VM2_IP=

# IP Tailscale của NODE-3 (Payment + Vault)
VM3_IP=
